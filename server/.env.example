# Gubera Vasal Backend API Configuration

# Port (Render injects PORT automatically in production; 5000 is for local dev)
PORT=5000
NODE_ENV=development

# Supabase Credentials (Found in Supabase Project Settings -> API)
# Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (RECOMMENDED for Backend: bypasses RLS securely) OR Anon Public Key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Allowed Frontend Origins (Comma-separated for Vercel + Local development)
CORS_ORIGIN=https://estate-santhosh.vercel.app,http://localhost:5173,http://localhost:3000

# Secret Key to access GET /api/enquiries lead list
ADMIN_SECRET_KEY=gubera2026admin
